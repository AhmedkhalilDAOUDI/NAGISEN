// Copy this file to Config/Secrets.xcconfig (ignored by git) and fill in the values from
// Supabase → Project Settings → API. Write the URL's // as /$()/ because xcconfig
// files treat // as the start of a comment.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
// Optional: Google Maps Platform key with Places API (New) enabled, restricted to this iOS bundle.
GOOGLE_PLACES_KEY = your-google-places-key
