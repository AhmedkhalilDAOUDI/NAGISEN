// Copy this file to Config/Secrets.xcconfig (ignored by git) and fill in the values from
// Supabase → Project Settings → API. Write the URL's // as /$()/ because xcconfig
// files treat // as the start of a comment.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
