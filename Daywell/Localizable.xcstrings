    },
    "Check your inbox and tap the confirmation link on this iPhone. It opens NAGISEN and signs you in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez votre boîte mail et touchez le lien de confirmation sur cet iPhone. Il ouvre NAGISEN et vous connecte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفقد بريدك واضغط على رابط التأكيد على هذا الآيفون. سيفتح NAGISEN ويسجّل دخولك."
          }
        }
      }
    },
    "Check your inbox to confirm the change. Your sign-in email stays the same until you do.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez votre boîte mail pour confirmer le changement. Votre e-mail de connexion reste le même d'ici là."
