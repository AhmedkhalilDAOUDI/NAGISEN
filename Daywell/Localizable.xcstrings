            "state": "translated",
            "value": "امشِ 2000 خطوة في الخارج قبل وجبتك التالية."
          }
        }
      }
    },
    "Walk 20 min carrying light groceries, then 10 calf raises.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez 20 min avec des courses légères, puis 10 élévations des mollets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امشِ 20 دقيقة تحمل مشتريات خفيفة، ثم 10 رفعات للسمانة."
          }
        }
      }
    },
    "Walk briskly for 20 min.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
