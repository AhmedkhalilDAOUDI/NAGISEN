      }
    },
    "Walk briskly for 25 min; make the final 5 min your strongest steady pace.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez d'un bon pas pendant 25 min ; les 5 dernières minutes, votre meilleure allure régulière."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امشِ بسرعة 25 دقيقة؛ واجعل آخر 5 دقائق أقوى إيقاع ثابت لديك."
          }
        }
      }
    },
    "Walk heel-to-toe near a wall for 5 min, then do 5 min easy walking.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez talon-pointe près d'un mur pendant 5 min, puis 5 min de marche tranquille."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امشِ كعبًا أمام أصابع قرب حائط 5 دقائق، ثم 5 دقائق مشي هادئ."
