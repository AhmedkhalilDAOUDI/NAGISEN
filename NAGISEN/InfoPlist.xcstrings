{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez des codes-barres, photographiez des emballages et prenez des photos et des vidéos pour vos cartes et vos publications."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الباركود، وصوّر عبوات الطعام، والتقط صورًا ومقاطع فيديو لبطاقاتك ومنشوراتك."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre voix pour rechercher un aliment et enregistrez le son des vidéos que vous filmez dans NAGISEN."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم صوتك للبحث عن الطعام، وسجّل الصوت مع مقاطع الفيديو التي تصوّرها في NAGISEN."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez le nom d'un aliment prononcé en recherche sur cet iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل اسم الطعام المنطوق إلى بحث على هذا الآيفون."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NAGISEN lit vos pas, votre activité, votre fréquence cardiaque, votre poids et vos séances pour montrer vos progrès. Vos données Santé restent sur cet iPhone, sauf le nombre de pas du jour si vous activez Utiliser mes données NAGISEN pour le coach."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ NAGISEN خطواتك ونشاطك ونبض قلبك ووزنك وتمارينك لعرض تقدمك. تبقى بيانات صحتك على هذا الآيفون، باستثناء عدد خطوات اليوم عند تفعيل استخدام بياناتي في NAGISEN للمدرب."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NAGISEN enregistre dans Apple Santé les séances lancées dans Accessoires, pour garder ensemble fréquence cardiaque et activité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ NAGISEN في صحتي التمارين التي تبدأها في الملحقات، لتبقى جلسة النبض والنشاط معًا."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des salles de sport près de vous. Votre position est envoyée uniquement pour les chercher sur la carte, et NAGISEN ne la conserve pas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن صالات رياضية قريبة منك. يُرسل موقعك فقط للبحث عنها على الخريطة، ولا يحتفظ به NAGISEN."
          }
        }
      }
    }
  },
  "version": "1.0"
}